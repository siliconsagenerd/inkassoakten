@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using InkassoAkten.Application.Interfaces
@using InkassoAkten.Web
@inject AuthenticationStateProvider AuthStateProvider
@inject IOperatorContextInitializer OperatorContext
@inject IOperatorContext SecurityContext
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PersistentComponentState ApplicationState

<div class="demo-disclaimer" role="note">
    Technische Demo mit synthetischen Daten — keine Rechtsberatung.
</div>

<header class="app-header">
    <div class="app-header-inner">
        <a class="app-brand" href="">InkassoAkten</a>
        <NavMenu />
        <div class="app-header-meta">
            @if (SecurityContext.PublicReadOnly)
            {
                <span class="badge-demo">Öffentliche, schreibgeschützte Demo</span>
            }
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="d-inline">
                        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Abmelden (@context.User.Identity?.Name)</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    @if (!SecurityContext.PublicReadOnly)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="/login">Operator-Anmeldung</a>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<main class="app-main">
    <article class="content px-4">
        @Body
    </article>
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string? antiforgeryToken;
    private PersistingComponentStateSubscription? subscription;

    protected override async Task OnInitializedAsync()
    {
        subscription = ApplicationState.RegisterOnPersisting(PersistState);
        if (ApplicationState.TryTakeFromJson<string>("logoutAntiforgeryToken", out var t))
        {
            antiforgeryToken = t;
        }
        else if (HttpContext is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
            antiforgeryToken = tokens.RequestToken;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        OperatorContext.SetOperator(state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Operator"));
    }

    private Task PersistState()
    {
        ApplicationState.PersistAsJson("logoutAntiforgeryToken", antiforgeryToken);
        return Task.CompletedTask;
    }

    public void Dispose() => subscription?.Dispose();
} 