@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using InkassoAkten.Application.Interfaces
@using InkassoAkten.Web
@inject AuthenticationStateProvider AuthStateProvider
@inject IOperatorContextInitializer OperatorContext
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PersistentComponentState ApplicationState

<div class="alert alert-warning mb-0 rounded-0 text-center" role="alert">
    Technische Demo mit synthetischen Daten — keine Rechtsberatung.
</div>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">InkassoAkten Demo</span>
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="d-inline">
                        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Abmelden (@context.User.Identity?.Name)</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-outline-primary" href="/login">Operator-Anmeldung</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string? antiforgeryToken;
    private PersistingComponentStateSubscription? subscription;

    protected override async Task OnInitializedAsync()
    {
        subscription = ApplicationState.RegisterOnPersisting(PersistState);
        if (ApplicationState.TryTakeFromJson<string>("antiforgeryToken", out var t))
        {
            antiforgeryToken = t;
        }
        else if (HttpContext is not null)
        {
            var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
            antiforgeryToken = tokens.RequestToken;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        OperatorContext.SetOperator(state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Operator"));
    }

    private Task PersistState()
    {
        ApplicationState.PersistAsJson("antiforgeryToken", antiforgeryToken);
        return Task.CompletedTask;
    }

    public void Dispose() => subscription?.Dispose();
}
