@page "/akten"
@rendermode InteractiveServer
@using InkassoAkten.Domain.Entities
@using InkassoAkten.Infrastructure
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject InkassoAktenDbContext Db

<PageTitle>InkassoAkten · Aktenverzeichnis</PageTitle>

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <div>
        <h1 class="h3 fw-bold mb-1">Aktenverzeichnis</h1>
        <p class="text-secondary small mb-0">Übersicht aller laufenden und abgeschlossenen Inkassovorgänge.</p>
    </div>
    <div class="text-secondary small">
        Gesamt: <strong class="text-dark">@totalCount</strong> Akten
    </div>
</div>

<div class="card p-3 mb-4 bg-white" style="border: 1px solid var(--border-color);">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary mb-1">Status</label>
            <select class="form-select form-select-sm" @bind="statusFilter" @bind:after="ReloadAsync">
                <option value="">Alle Status</option>
                @foreach (var s in Enum.GetNames<AkteStatus>())
                {
                    <option value="@s">@FormatStatus(Enum.Parse<AkteStatus>(s))</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary mb-1">Schuldner</label>
            <input class="form-control form-select-sm" placeholder="Name oder Firma…" @bind="debtorFilter" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-secondary mb-1">Mandant</label>
            <input class="form-control form-select-sm" placeholder="Firmenname…" @bind="creditorFilter" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-secondary mb-1">Sortierung</label>
            <select class="form-select form-select-sm" @bind="sortBy" @bind:after="ReloadAsync">
                <option value="Aktenzeichen">Aktenzeichen</option>
                <option value="Saldo">Saldo (absteigend)</option>
                <option value="Faelligkeit">Fälligkeit</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-sm btn-primary flex-fill" @onclick="ReloadAsync" disabled="@isLoading">Filtern</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync" disabled="@isLoading" title="Filter zurücksetzen">Zurücksetzen</button>
        </div>
    </div>
    <div class="d-flex gap-4 mt-2 pt-2 border-top">
        <div class="form-check form-check-inline small mb-0">
            <input class="form-check-input" type="checkbox" @bind="overdueOnly" @bind:after="ReloadAsync" id="overdue" />
            <label class="form-check-label text-secondary" for="overdue">Nur überfällige Forderungen</label>
        </div>
        <div class="form-check form-check-inline small mb-0">
            <input class="form-check-input" type="checkbox" @bind="openOnly" @bind:after="ReloadAsync" id="open" />
            <label class="form-check-label text-secondary" for="open">Nur offene Salden (> 0,00 €)</label>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="p-4 text-center text-secondary small bg-white rounded border" style="border-color: var(--border-color) !important;">
        Lade Akten…
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger small">@errorMessage</div>
}
else if (items.Count == 0)
{
    <div class="p-4 text-center text-secondary small bg-white rounded border" style="border-color: var(--border-color) !important;">
        Keine Akten für die ausgewählten Filterkriterien gefunden.
    </div>
}
else
{
    <div class="table-responsive bg-white rounded" style="border: 1px solid var(--border-color);">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 140px;">Aktenzeichen</th>
                    <th scope="col">Mandant</th>
                    <th scope="col">Schuldner</th>
                    <th scope="col" style="width: 170px;">Status</th>
                    <th scope="col" class="text-end" style="width: 130px;">Saldo</th>
                    <th scope="col" class="text-end" style="width: 110px;">Fälligkeit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in items)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none" href="/akten/@a.AkteId">@a.Aktenzeichen</a>
                        </td>
                        <td class="text-secondary">@a.Mandant?.Firmenname</td>
                        <td>
                            <span class="fw-medium">@a.Schuldner?.NachnameOderFirma</span>@(string.IsNullOrWhiteSpace(a.Schuldner?.Vorname) ? "" : $", {a.Schuldner.Vorname}")
                        </td>
                        <td>
                            <span class="badge-status @GetStatusBadgeClass(a.AkteStatus)">
                                @FormatStatus(a.AkteStatus)
                            </span>
                        </td>
                        <td class="text-end tabular-nums fw-semibold">@a.Gesamtsaldo.ToString("C", de)</td>
                        <td class="text-end tabular-nums text-secondary small">
                            @(a.Forderung?.Faelligkeitsdatum.ToString("dd.MM.yyyy", de) ?? "–")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <button class="btn btn-sm btn-outline-secondary px-3" @onclick="PreviousPage" disabled="@(page <= 1 || isLoading)">
            &larr; Vorherige
        </button>
        <span class="small text-secondary">
            Seite <strong class="text-dark">@(page)</strong> von <strong class="text-dark">@totalPages</strong> (@totalCount Vorgänge)
        </span>
        <button class="btn btn-sm btn-outline-secondary px-3" @onclick="NextPage" disabled="@(page >= totalPages || isLoading)">
            Nächste &rarr;
        </button>
    </div>
}

@code {
    private static readonly CultureInfo de = CultureInfo.GetCultureInfo("de-DE");

    private List<InkassoAkte> items = new();
    private bool isLoading;
    private string? errorMessage;
    private int page = 1;
    private int pageSize = 10;
    private int totalCount;
    private int totalPages = 1;

    private string? statusFilter;
    private string? debtorFilter;
    private string? creditorFilter;
    private bool overdueOnly;
    private bool openOnly;
    private string sortBy = "Aktenzeichen";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        statusFilter = null;
        debtorFilter = null;
        creditorFilter = null;
        overdueOnly = false;
        openOnly = false;
        sortBy = "Aktenzeichen";
        page = 1;
        await ReloadAsync();
    }

    private string FormatStatus(AkteStatus s) => s switch
    {
        AkteStatus.Aktenanlage => "Aktenanlage",
        AkteStatus.VorgerichtlicheMahnung => "Vorgerichtliche Mahnung",
        AkteStatus.RatenplanAktiv => "Ratenplan aktiv",
        AkteStatus.GerichtlichesMahnverfahren => "Gerichtliches Mahnverfahren",
        AkteStatus.Erledigt => "Erledigt",
        AkteStatus.Geschlossen => "Geschlossen",
        _ => s.ToString()
    };

    private string GetStatusBadgeClass(AkteStatus s) => s switch
    {
        AkteStatus.Aktenanlage => "badge-status-aktenanlage",
        AkteStatus.VorgerichtlicheMahnung => "badge-status-mahnung",
        AkteStatus.RatenplanAktiv => "badge-status-ratenplan",
        AkteStatus.GerichtlichesMahnverfahren => "badge-status-gericht",
        AkteStatus.Erledigt => "badge-status-erledigt",
        AkteStatus.Geschlossen => "badge-status-geschlossen",
        _ => "badge-status-aktenanlage"
    };

    private async Task ReloadAsync()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;
        try
        {
            var query = Db.InkassoAkten.AsNoTracking()
                .Include(a => a.Mandant)
                .Include(a => a.Schuldner)
                .Include(a => a.Forderung)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(statusFilter) && Enum.TryParse<AkteStatus>(statusFilter, out var status))
                query = query.Where(a => a.AkteStatus == status);

            if (!string.IsNullOrWhiteSpace(debtorFilter))
                query = query.Where(a => a.Schuldner != null &&
                    (a.Schuldner.NachnameOderFirma.Contains(debtorFilter) ||
                     (a.Schuldner.Vorname != null && a.Schuldner.Vorname.Contains(debtorFilter))));

            if (!string.IsNullOrWhiteSpace(creditorFilter))
                query = query.Where(a => a.Mandant != null && a.Mandant.Firmenname.Contains(creditorFilter));

            if (overdueOnly)
            {
                var today = DateOnly.FromDateTime(DateTime.UtcNow);
                query = query.Where(a => a.Forderung != null && a.Forderung.Faelligkeitsdatum < today);
            }

            if (openOnly)
                query = query.Where(a => a.OffeneKosten + a.OffeneZinsen + a.OffeneHauptforderung > 0m);

            query = sortBy switch
            {
                "Saldo" => query.OrderByDescending(a => a.OffeneKosten + a.OffeneZinsen + a.OffeneHauptforderung),
                "Faelligkeit" => query.OrderBy(a => a.Forderung!.Faelligkeitsdatum),
                _ => query.OrderBy(a => a.Aktenzeichen)
            };

            totalCount = await query.CountAsync();
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            if (page > totalPages) page = totalPages;
            if (page < 1) page = 1;

            items = await query.Skip((page - 1) * pageSize).Take(pageSize).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            items = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (page > 1) { page--; await ReloadAsync(); }
    }

    private async Task NextPage()
    {
        if (page < totalPages) { page++; await ReloadAsync(); }
    }
}
