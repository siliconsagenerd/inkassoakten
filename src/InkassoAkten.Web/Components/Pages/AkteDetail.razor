@page "/akten/{id:int}"
@implements IDisposable
@rendermode InteractiveServer
@using InkassoAkten.Domain.Entities
@using InkassoAkten.Domain.Strategies
@using InkassoAkten.Domain.ValueObjects
@using InkassoAkten.Domain.Exceptions
@using InkassoAkten.Infrastructure
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject InkassoAktenDbContext Db
@inject ZahlungPostingService PostingService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Akte @id</PageTitle>

@if (isLoading)
{
    <p>Laden…</p>
}
else if (akte is null)
{
    <div class="alert alert-warning">Akte nicht gefunden.</div>
}
else
{
    <div class="mb-3">
        <a class="text-secondary small text-decoration-none" href="/akten">
            &larr; Zurück zu den Akten
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1">@akte.Aktenzeichen</h1>
            <p class="text-secondary small mb-0">@akte.Mandant?.Firmenname · @akte.Schuldner?.NachnameOderFirma@(string.IsNullOrWhiteSpace(akte.Schuldner?.Vorname) ? "" : $", {akte.Schuldner.Vorname}")</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="/api/akten/@akte.AkteId/pdf" target="_blank">
                PDF herunterladen
            </a>
            <span class="badge-status @GetStatusBadgeClass(akte.AkteStatus)">
                @FormatStatus(akte.AkteStatus)
            </span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger">@actionError</div>
    }
    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="alert alert-success">@actionMessage</div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(activeTab=="Uebersicht"?"active":"")" @onclick='() => activeTab="Uebersicht"'>Übersicht</button></li>
        <li class="nav-item"><button class="nav-link @(activeTab=="Ledger"?"active":"")" @onclick='() => activeTab="Ledger"'>Buchungsjournal</button></li>
        <li class="nav-item"><button class="nav-link @(activeTab=="Raten"?"active":"")" @onclick='() => activeTab="Raten"'>Ratenplan</button></li>
        <li class="nav-item"><button class="nav-link @(activeTab=="Audit"?"active":"")" @onclick='() => activeTab="Audit"'>Prüfprotokoll</button></li>
        <li class="nav-item"><button class="nav-link @(activeTab=="Zahlung"?"active":"")" @onclick='() => activeTab="Zahlung"'>Zahlung</button></li>
    </ul>

    @if (activeTab == "Uebersicht")
    {
        <div class="card mb-4 bg-white" style="border: 1px solid var(--border-color);">
            <div class="card-body py-3">
                <div class="row text-center g-0">
                    <div class="col-6 col-md-3 border-end">
                        <div class="text-secondary small mb-1">Offene Kosten</div>
                        <div class="fw-semibold tabular-nums">@akte.OffeneKosten.ToString("C", de)</div>
                    </div>
                    <div class="col-6 col-md-3 border-end">
                        <div class="text-secondary small mb-1">Offene Zinsen</div>
                        <div class="fw-semibold tabular-nums">@akte.OffeneZinsen.ToString("C", de)</div>
                    </div>
                    <div class="col-6 col-md-3 border-end">
                        <div class="text-secondary small mb-1">Offene Hauptforderung</div>
                        <div class="fw-semibold tabular-nums">@akte.OffeneHauptforderung.ToString("C", de)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-secondary small mb-1">Gesamtsaldo</div>
                        <div class="fw-bold tabular-nums" style="color: var(--accent); font-size: 1.15rem;">@akte.Gesamtsaldo.ToString("C", de)</div>
                    </div>
                </div>
            </div>
        </div>

        @if (isOperator)
        {
        <h5>Statusaktionen</h5>
        <div class="btn-group flex-wrap">
            @if (akte.AkteStatus == AkteStatus.Aktenanlage)
            {
                <button class="btn btn-outline-primary" @onclick="StartDunning" disabled="@isActionRunning">Vorgerichtliche Mahnung starten</button>
            }
            @if (akte.AkteStatus == AkteStatus.VorgerichtlicheMahnung)
            {
                <button class="btn btn-outline-primary" @onclick="RaiseDunning" disabled="@isActionRunning">Mahnstufe erhöhen</button>
                <button class="btn btn-outline-primary" @onclick="ActivatePlan" disabled="@isActionRunning">Ratenplan aktivieren</button>
                <button class="btn btn-outline-warning" @onclick="Escalate" disabled="@isActionRunning">Zum gerichtlichen Mahnverfahren</button>
                <button class="btn btn-outline-success" @onclick="MarkDone" disabled="@isActionRunning">Erledigt markieren</button>
            }
            @if (akte.AkteStatus == AkteStatus.RatenplanAktiv)
            {
                <button class="btn btn-outline-warning" @onclick="Escalate" disabled="@isActionRunning">Zum gerichtlichen Mahnverfahren</button>
                <button class="btn btn-outline-success" @onclick="MarkDone" disabled="@isActionRunning">Erledigt markieren</button>
            }
            @if (akte.AkteStatus == AkteStatus.GerichtlichesMahnverfahren)
            {
                <button class="btn btn-outline-success" @onclick="MarkDone" disabled="@isActionRunning">Erledigt markieren</button>
            }
            @if (akte.AkteStatus == AkteStatus.Erledigt)
            {
                <button class="btn btn-outline-dark" @onclick="Close" disabled="@(isActionRunning || akte.Gesamtsaldo > 0m)">Schließen</button>
            }
        </div>
        }
        else
        {
            <div class="alert alert-secondary">Statusänderungen erfordern Operator-Anmeldung.</div>
        }
    }
    else if (activeTab == "Ledger")
    {
        if (buchungen.Count == 0)
        {
            <p class="text-muted">Keine Buchungen vorhanden.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th class="text-end">Kosten</th>
                        <th class="text-end">Zinsen</th>
                        <th class="text-end">Hauptforderung</th>
                        <th class="text-end">Gesamt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in buchungen)
                    {
                        <tr>
                            <td>@b.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm", de)</td>
                            <td class="text-end tabular-nums">@b.BetragKosten.ToString("C", de)</td>
                            <td class="text-end tabular-nums">@b.BetragZinsen.ToString("C", de)</td>
                            <td class="text-end tabular-nums">@b.BetragHauptforderung.ToString("C", de)</td>
                            <td class="text-end tabular-nums fw-semibold">@((b.BetragKosten + b.BetragZinsen + b.BetragHauptforderung).ToString("C", de))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (activeTab == "Raten")
    {
        if (plaene.Count == 0)
        {
            <p class="text-muted">Keine Ratenpläne vorhanden.</p>
        }
        else
        {
            @foreach (var p in plaene)
            {
                <div class="card mb-3">
                    <div class="card-header">Plan @p.PlanId · Gesamt @p.Gesamtbetrag.ToString("C", de) · @(p.IstDefaulted ? "Defaulted" : "Aktiv")</div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Fälligkeit</th><th>Betrag</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var r in p.Raten)
                                {
                                    <tr>
                                        <td>@r.Faelligkeitsdatum.ToString("dd.MM.yyyy", de)</td>
                                        <td>@r.Betrag.ToString("C", de)</td>
                                        <td>@(r.IstBezahlt ? "Bezahlt" : "Offen")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
    else if (activeTab == "Audit")
    {
        if (audits.Count == 0)
        {
            <p class="text-muted">Keine Audit-Einträge vorhanden.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Zeit</th><th>Aktion</th><th>Entität</th><th>Werte</th></tr></thead>
                <tbody>
                    @foreach (var a in audits)
                    {
                        <tr>
                            <td>@a.ZeitstempelUtc.ToString("dd.MM.yyyy HH:mm", de)</td>
                            <td>@a.Aktion</td>
                            <td>@a.EntitaetName #@a.EntitaetId</td>
                            <td>@a.NeuWerteJson</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (activeTab == "Zahlung")
    {
        <div class="card mb-3 bg-white" style="border: 1px solid var(--border-color);">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary mb-1" for="zahlung-betrag">Zahlungsbetrag</label>
                        <input id="zahlung-betrag" class="form-control" type="number" step="0.01" min="0.01"
                               @bind="paymentAmount" @bind:event="oninput" @onchange="UpdatePreview" />
                        <div class="form-text small">Maximal der Gesamtsaldo der Akte.</div>
                    </div>
                    <div class="col-md-8">
                        <p class="small text-secondary mb-0">
                            Vorschau der Verrechnung nach § 367 BGB: Kosten &rarr; Zinsen &rarr; Hauptforderung.
                            <strong>Diese Vorschau persistiert keine Änderungen.</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @if (preview is not null)
        {
            <div class="card mb-3 bg-white" style="border: 1px solid var(--border-color);">
                <div class="card-body py-3">
                    <div class="row text-center g-0">
                        <div class="col-12 col-md-4 border-end mb-2 mb-md-0">
                            <div class="text-secondary small mb-1">Aktueller Saldo</div>
                            <div class="fw-semibold tabular-nums">@akte.Gesamtsaldo.ToString("C", de)</div>
                            <div class="small text-muted tabular-nums">
                                Kosten @akte.OffeneKosten.ToString("C", de) · Zinsen @akte.OffeneZinsen.ToString("C", de) · Hauptf. @akte.OffeneHauptforderung.ToString("C", de)
                            </div>
                        </div>
                        <div class="col-12 col-md-4 border-end mb-2 mb-md-0">
                            <div class="text-secondary small mb-1">Verrechnung</div>
                            <div class="fw-semibold tabular-nums" style="color: var(--accent);">@preview.Gesamtbetrag.ToString("C", de)</div>
                            <div class="small text-muted tabular-nums">
                                Kosten @preview.GetilgteKosten.ToString("C", de) · Zinsen @preview.GetilgteZinsen.ToString("C", de) · Hauptf. @preview.GetilgteHauptforderung.ToString("C", de)
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="text-secondary small mb-1">Neuer Saldo</div>
                            <div class="fw-bold tabular-nums" style="color: var(--accent); font-size: 1.15rem;">@preview.NeuerSaldo.ToString("C", de)</div>
                            <div class="small text-muted tabular-nums">
                                Kosten @( (akte.OffeneKosten - preview.GetilgteKosten).ToString("C", de) ) · Zinsen @( (akte.OffeneZinsen - preview.GetilgteZinsen).ToString("C", de) ) · Hauptf. @( (akte.OffeneHauptforderung - preview.GetilgteHauptforderung).ToString("C", de) )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (paymentAmount > 0m)
        {
            <div class="alert alert-warning small">
                Betrag ungültig: muss positiv und darf den Gesamtsaldo von @akte.Gesamtsaldo.ToString("C", de) nicht überschreiten.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(paymentError))
        {
            <div class="alert alert-danger small">@paymentError</div>
        }
        @if (!string.IsNullOrWhiteSpace(paymentMessage))
        {
            <div class="alert alert-success small">@paymentMessage</div>
        }

        @if (isOperator)
        {
            <button class="btn btn-primary" @onclick="PostPayment" disabled="@(isPosting || paymentAmount <= 0m || preview is null)">Zahlung verbuchen</button>
            @if (isPosting)
            {
                <span class="ms-2">Verbuche…</span>
            }
        }
        else
        {
            <div class="alert alert-secondary small">Zahlung verbuchen erfordert Operator-Anmeldung.</div>
        }
    }
}

@code {
    [Parameter] public int id { get; set; }

    private static readonly CultureInfo de = CultureInfo.GetCultureInfo("de-DE");

    private InkassoAkte? akte;
    private List<Buchung> buchungen = new();
    private List<AuditEintrag> audits = new();
    private List<Ratenzahlungsplan> plaene = new();
    private bool isLoading = true;
    private string activeTab = "Uebersicht";
    private string? actionError;
    private string? actionMessage;
    private bool isActionRunning;
    private bool isOperator;

    private decimal paymentAmount;
    private bool isPosting;
    private string? paymentError;
    private string? paymentMessage;
    private TilgungsAllocation? preview;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isOperator = state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Operator");
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            isOperator = state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Operator");
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        actionError = null;
        try
        {
            akte = await Db.InkassoAkten
                .Include(a => a.Mandant)
                .Include(a => a.Schuldner)
                .Include(a => a.Forderung)
                .FirstOrDefaultAsync(a => a.AkteId == id);

            if (akte is not null)
            {
                buchungen = await Db.Buchungen.Where(b => b.AkteId == id).OrderBy(b => b.CreatedAtUtc).ToListAsync();
                var zahlungIds = await Db.Zahlungen.Where(z => z.AkteId == id).Select(z => z.ZahlungId).ToListAsync();
                audits = await Db.AuditEintraege
                    .Where(a => (a.EntitaetName == "InkassoAkte" && a.EntitaetId == id) ||
                                (a.Aktion == "PaymentPosted" && zahlungIds.Contains(a.EntitaetId)))
                    .OrderByDescending(a => a.ZeitstempelUtc)
                    .Take(100)
                    .ToListAsync();
                plaene = await Db.Ratenzahlungsplaene.Include(p => p.Raten).Where(p => p.AkteId == id).ToListAsync();
            }
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdatePreview()
    {
        if (akte is null) return;
        try
        {
            preview = new StandardTilgungsStrategie().Verrechne(paymentAmount, akte.OffeneKosten, akte.OffeneZinsen, akte.OffeneHauptforderung);
        }
        catch
        {
            preview = null;
        }
    }

    private async Task PostPayment()
    {
        if (akte is null) return;
        isPosting = true;
        paymentError = null;
        paymentMessage = null;
        try
        {
            var zahlung = await PostingService.PosteZahlungAsync(akte.AkteId, paymentAmount, DateTime.UtcNow, new StandardTilgungsStrategie());
            paymentMessage = $"Zahlung {zahlung.Betrag.ToString("C", de)} verbucht.";
            paymentAmount = 0m;
            preview = null;
            await LoadAsync();
        }
        catch (DomainException ex)
        {
            paymentError = ex.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            paymentError = "Konflikt: Die Akte wurde zwischenzeitlich geändert. Neu geladen.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            paymentError = ex.Message;
        }
        finally
        {
            isPosting = false;
        }
    }

    private async Task RunAction(Func<Task> action)
    {
        isActionRunning = true;
        actionError = null;
        actionMessage = null;
        try
        {
            await action();
            actionMessage = "Aktion ausgeführt.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isActionRunning = false;
        }
    }

    private Task StartDunning() => RunAction(async () => { akte!.StarteVorgerichtlicheMahnung(); await Db.SaveChangesAsync(); });
    private Task RaiseDunning() => RunAction(async () => { akte!.ErhoeheMahnstufe(); await Db.SaveChangesAsync(); });
    private Task ActivatePlan() => RunAction(async () => { akte!.AktiviereRatenplan(); await Db.SaveChangesAsync(); });
    private Task Escalate() => RunAction(async () => { akte!.EskaliereZumGerichtlichenMahnverfahren(akte.HatAktivenNichtDefaultedRatenplan()); await Db.SaveChangesAsync(); });
    private Task MarkDone() => RunAction(async () => { akte!.MarkiereErledigt(); await Db.SaveChangesAsync(); });
    private Task Close() => RunAction(async () => { akte!.Schliesse(); await Db.SaveChangesAsync(); });

    private string FormatStatus(AkteStatus s) => s switch
    {
        AkteStatus.Aktenanlage => "Aktenanlage",
        AkteStatus.VorgerichtlicheMahnung => "Vorgerichtliche Mahnung",
        AkteStatus.RatenplanAktiv => "Ratenplan aktiv",
        AkteStatus.GerichtlichesMahnverfahren => "Gerichtliches Mahnverfahren",
        AkteStatus.Erledigt => "Erledigt",
        AkteStatus.Geschlossen => "Geschlossen",
        _ => s.ToString()
    };

    private string GetStatusBadgeClass(AkteStatus s) => s switch
    {
        AkteStatus.Aktenanlage => "badge-status-aktenanlage",
        AkteStatus.VorgerichtlicheMahnung => "badge-status-mahnung",
        AkteStatus.RatenplanAktiv => "badge-status-ratenplan",
        AkteStatus.GerichtlichesMahnverfahren => "badge-status-gericht",
        AkteStatus.Erledigt => "badge-status-erledigt",
        AkteStatus.Geschlossen => "badge-status-geschlossen",
        _ => "badge-status-aktenanlage"
    };
}
